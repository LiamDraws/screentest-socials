# Copy this to .env for local testing (npm install dotenv if you want
# auto-loading, or just `export $(cat .env | xargs)` before running).
# In GitHub Actions, these live in repo Settings -> Secrets and variables
# -> Actions instead — never commit real values.

SCREENTEST_SITE_URL=https://screentest.au
GAME_ROTATION=

BLUESKY_IDENTIFIER=screentestgames.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_CARD_SIZE=landscape

X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_CARD_SIZE=landscape
X_INCLUDE_LINK=false

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_CARD_SIZE=portrait

DRY_RUN=true
